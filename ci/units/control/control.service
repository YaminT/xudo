# The units lane's control: a service the lane must accept, and the base every
# self-test mutation of it starts from (ci/units/check.sh). It is sandboxed the
# way the broker's service is, so that it sits under the exposure ceiling and
# one removed line can be seen to push it over. It is never installed.

[Unit]
Description=xudo units lane control service

[Service]
ExecStart=/usr/libexec/xudo/control
RuntimeMaxSec=30
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
