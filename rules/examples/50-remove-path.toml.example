# EXAMPLE. Not a shipped rule.
#
# The loader reads only names ending in `.toml` in the rules directory, and the
# package installs this file under /usr/share/xudo/examples, so it is never
# loaded by accident. To let an operator remove a build tree:
#
#   cp /usr/share/xudo/examples/50-remove-path.toml /etc/xudo/rules.d/
#
# Then replace `under` with the tree this host should expose. The directory
# itself is never removed. Every ancestor, from `/` down to `under`, must be
# owned by root and must not be writable by group or other. The walk refuses
# a symlink component, a mount point, and another filesystem.
#
# Omit `owners` to allow any uid except root on the password path. A listed
# name that is not in the passwd text the broker reads fails closed:
#
#   owners = ["agent", "www-data"]
#
# A rule that lists a `harness` MUST set `owners`: a grant without a password
# never falls back to "any owner", or it could delete other accounts' files.
#
# `harness` with `outcome = "allow"` lets a live enrolled harness from
# /etc/xudo/harnesses.d run this operation without a password, through the
# -nopass gate, which does nothing until root adds a sudoers line for it. The
# walk is the same. Everyone else uses the password path:
#
#   owners = ["agent"]
#   harness = ["codex"]
#   outcome = "allow"
#
# Then: xudo op remove-path /srv/app/build/cache
#       xudo op remove-path --dry-run /srv/app/build/cache

[[operation]]
id = "web.clean-build"
op = "remove-path"
under = "/srv/app/build"
recursive = true
max-depth = 8
max-entries = 10000
