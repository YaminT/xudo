# Static musl binaries on purpose: no shared libraries to swap under a root helper.
xudo: statically-linked-binary [*]
# Static-pie executables, not libraries; file shows "static-pie linked".
xudo: shared-library-lacks-prerequisites [usr/bin/ido]
xudo: shared-library-lacks-prerequisites [usr/bin/willyoumarryme]
xudo: shared-library-lacks-prerequisites [usr/bin/xudo]
xudo: shared-library-lacks-prerequisites [usr/libexec/xudo/xudo-gate-auth]
xudo: shared-library-lacks-prerequisites [usr/libexec/xudo/xudod]
# The packaged binary, called by absolute path. Root's PATH is not searched.
xudo: command-with-path-in-maintainer-script /usr/bin/xudo*
