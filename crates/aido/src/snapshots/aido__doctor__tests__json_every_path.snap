  "proposals": [
    {
      "id": "join-aido",
      "title": "add yamin to the aido group",
      "means": "Membership is what lets you ask aido to run an allowlisted command as root. Your backend asks for your password: this release installs no rule that skips it, though a backend that caches a credential (sudo for a few minutes, OpenDoas when it is built with timestamps) may not ask again straight away. It takes effect at your next login, and aido grants it to nobody on its own.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/sbin/usermod",
          "--append",
          "--groups",
          "aido",
          "yamin"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "leave-docker",
      "title": "leave the docker group",
      "means": "Being in the docker group means the Docker daemon runs as root and starts any container you ask for, including one with / mounted (`docker run -v /:/host`): root, with no password. Leaving it removes that path to root. Rootless Docker or Podman runs containers without it. Sessions already open keep the group until they end.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/bin/gpasswd",
          "--delete",
          "yamin",
          "docker"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "leave-lxd",
      "title": "leave the lxd group",
      "means": "Being in the lxd group means the LXD daemon starts a privileged container with the host's / attached on request: root, with no password. Leaving it removes that path to root. Containers you manage will need sudo afterwards. Sessions already open keep the group until they end.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/bin/gpasswd",
          "--delete",
          "yamin",
          "lxd"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "leave-libvirt",
      "title": "leave the libvirt group",
      "means": "Being in the libvirt group means the system libvirt daemon starts a VM with the host's disks attached on request: root, with no password. Leaving it removes that path to root. Your own session VMs (qemu:///session) keep working without it. Sessions already open keep the group until they end.",
      "needs_root": true,
      "commands": [],
      "by_hand": "This session holds the libvirt group, but /etc/group does not list you in it: it comes from a directory service or from how this session was started. Remove it there, then log in again."
    },
    {
      "id": "review-sudoers-1",
      "title": "review the passwordless rules in /etc/sudoers",
      "means": "Opens /etc/sudoers in visudo, as root, so you can remove NOPASSWD or !authenticate from line(s) 3, and rewrite the include on line(s) 4 on one physical line, with no backslash continuation, so it can be checked. Whoever relies on those rules will be asked for a password. aido does not edit another tool's rules: one mistake in sudoers can lock every administrator out, and visudo refuses to save one.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/sbin/visudo",
          "-f",
          "/etc/sudoers"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "review-sudoers-2",
      "title": "review the passwordless rules in /etc/sudoers.d/90 cloud",
      "means": "Opens /etc/sudoers.d/90 cloud in visudo, as root, so you can remove NOPASSWD or !authenticate from line(s) 1. Whoever relies on those rules will be asked for a password. aido does not edit another tool's rules: one mistake in sudoers can lock every administrator out, and visudo refuses to save one.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/sbin/visudo",
          "-f",
          "/etc/sudoers.d/90 cloud"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "review-sudoers-3",
      "title": "review the passwordless rules in /etc/sudoers.d/91-defaults",
      "means": "Opens /etc/sudoers.d/91-defaults in visudo, as root, so you can remove NOPASSWD or !authenticate from line(s) 1. Whoever relies on those rules will be asked for a password. aido does not edit another tool's rules: one mistake in sudoers can lock every administrator out, and visudo refuses to save one.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/sbin/visudo",
          "-f",
          "/etc/sudoers.d/91-defaults"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "review-doas-1",
      "title": "review the passwordless rules in /etc/doas.conf",
      "means": "Removes a standing grant that runs commands as root with no password, from line(s) 1. Whoever relies on it will be asked for one.",
      "needs_root": true,
      "commands": [],
      "by_hand": "Edit /etc/doas.conf as root, remove nopass from line(s) 1, and check the result with `doas -C /etc/doas.conf` before you log out."
    },
    {
      "id": "protect-1",
      "title": "make /etc/systemd/system writable by root alone",
      "means": "Only root will be able to change /etc/systemd/system, which root trusts. The group adm (4) can no longer write there; if that was deliberate \u2014 a deploy group, say \u2014 give them a directory root does not run anything from instead. Whatever it holds now was put there by someone who could write it: review that too.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/bin/chmod",
          "go-w",
          "/etc/systemd/system"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "protect-2",
      "title": "make /run/systemd/system writable by root alone",
      "means": "Only root will be able to change /run/systemd/system, which root trusts. Its owner, alice (1001) can no longer write there; if that was deliberate \u2014 a deploy group, say \u2014 give them a directory root does not run anything from instead. Whatever it holds now was put there by someone who could write it: review that too.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/bin/chown",
          "root",
          "/run/systemd/system"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "protect-3",
      "title": "make /usr/local/lib/systemd/system writable by root alone",
      "means": "Only root will be able to change /usr/local/lib/systemd/system, which root trusts. You can no longer write there; if that was deliberate \u2014 a deploy group, say \u2014 give them a directory root does not run anything from instead. Whatever it holds now was put there by someone who could write it: review that too.",
      "needs_root": true,
      "commands": [],
      "by_hand": "An access control list, or a capability, lets you write /usr/local/lib/systemd/system; its mode bits do not show it. Inspect it with `getfacl /usr/local/lib/systemd/system` and remove the entry as root."
    },
    {
      "id": "protect-4",
      "title": "make /usr/lib/systemd/system/b.service writable by root alone",
      "means": "Only root will be able to change /usr/lib/systemd/system/b.service, which root trusts. Its owner, 4242 and the group 4243 can no longer write there; if that was deliberate \u2014 a deploy group, say \u2014 give them a directory root does not run anything from instead. Its contents were written by someone who could write it: inspect them, or reinstall the file from its package, before you rely on it.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/bin/chown",
          "root",
          "/usr/lib/systemd/system/b.service"
        ],
        [
          "/usr/bin/sudo",
          "/usr/bin/chmod",
          "go-w",
          "/usr/lib/systemd/system/b.service"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "protect-5",
      "title": "take /usr/lib/systemd/system-generators out of /usr/lib/systemd",
      "means": "The group 0 and everyone can write /usr/lib/systemd, and root trusts /usr/lib/systemd/system-generators through it. /usr/lib/systemd is shared or someone's home, so it is left as it is and what root trusts is moved out of it.",
      "needs_root": true,
      "commands": [],
      "by_hand": "Do not change who owns /usr/lib/systemd. As root, inspect /usr/lib/systemd/system-generators and, if it is yours, move it to a directory only root can write, or remove it."
    },
    {
      "id": "protect-6",
      "title": "make /opt/rootbin writable by root alone",
      "means": "Only root will be able to change /opt/rootbin, which root trusts. Its owner, yamin (1000) can no longer write there; if that was deliberate \u2014 a deploy group, say \u2014 give them a directory root does not run anything from instead. Whatever it holds now was put there by someone who could write it: review that too.",
      "needs_root": true,
      "commands": [
        [
          "/usr/bin/sudo",
          "/usr/bin/chown",
          "root",
          "/opt/rootbin"
        ]
      ],
      "by_hand": null
    },
    {
      "id": "protect-7",
      "title": "make /etc/environment writable by root alone",
      "means": "Only root will be able to change /etc/environment, which root trusts. The group 0 and everyone can no longer write there; if that was deliberate \u2014 a deploy group, say \u2014 give them a directory root does not run anything from instead. Its contents were written by someone who could write it: inspect them, or reinstall the file from its package, before you rely on it.",
      "needs_root": true,
      "commands": [
        [
