      "by_hand": "As root, make root the owner of /etc/profile.d/x\u001b[2Jy.sh and remove group and other write permission from it."
    },
    {
      "id": "fix-path-1",
      "title": "take /home/yamin/bin off your PATH, or move it later",
      "means": "Anything running as you can put a program in /home/yamin/bin, and it comes before /usr/bin/sudo: a program of that name placed there runs instead of the real one, and is handed the password you type to it.",
      "needs_root": false,
      "commands": [],
      "by_hand": "Edit the shell startup file that sets PATH (~/.profile, ~/.bashrc, ~/.zshrc, or fish's config.fish) and remove the entry, or move it after the system directories."
    },
    {
      "id": "fix-path-2",
      "title": "take the relative entry \"\" off your PATH",
      "means": "A relative PATH entry is looked up in whatever directory you are in, so the next command you type in an agent's working tree may run a program the agent put there.",
      "needs_root": false,
      "commands": [],
      "by_hand": "Edit the shell startup file that sets PATH (~/.profile, ~/.bashrc, ~/.zshrc, or fish's config.fish) and remove the entry, or move it after the system directories."
    }
