.TH XUDO 1 "2026-11-13" "xudo 0.1.0-beta.1" "User Commands"
.SH NAME
xudo \- decide whether a privileged command runs as root
.SH SYNOPSIS
.B xudo
.RI [ options ]
.I command
.RI [ args ]
.br
.B xudo explain
.RB [ \-\-action
.IR id ]
.RB [ options ]
.B \-\-
.I program
.RI [ arg ...]
.br
.B xudo why\-not
.B \-\-action
.I id
.RB [ options ]
.B \-\-
.I program
.RI [ arg ...]
.br
.B xudo exec
.RB [ options ]
.RB [ \-\-queue ]
.B \-\-
.I program
.RI [ arg ...]
.br
.B xudo check
.RB [ \-\-tests\-only "\||\|" \-\-fuzz
.RB [ \-\-fuzz\-budget
.IR n ]
.RB [ \-\-fuzz\-seed
.IR s ]]
.RB [ options ]
.br
.B xudo list
.RB [ \-\-tier
.IR tier ]
.RB [ options ]
.br
.B xudo doctor
.RB [ \-\-json ]
.RB [ \-\-fix ]
.RB [ options ]
.br
.B xudo config
.RB [ \-\-schema ]
.RB [ options ]
.br
.B xudo config get
.I key
.RB [ \-\-origin ]
.br
.B xudo config list
.RB [ \-\-origin ]
.RB [ \-\-effective ]
.br
.B xudo config schema
.RB [ \-\-json ]
.br
.B xudo install
.RB [ \-\-dry\-run ]
.RB [ \-\-show\-contents ]
.RB [ \-\-uninstall ]
.RB [ options ]
.br
